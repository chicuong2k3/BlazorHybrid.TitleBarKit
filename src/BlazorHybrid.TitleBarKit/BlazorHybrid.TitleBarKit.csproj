<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- This is a Razor class library, not an executable MAUI app. Microsoft.Maui.Controls
         supplies lifecycle APIs without importing host-owned BlazorWebView static assets. -->
    <RootNamespace>BlazorHybrid.TitleBarKit</RootNamespace>
    <AssemblyName>BlazorHybrid.TitleBarKit</AssemblyName>
    <PackageId>BlazorHybrid.TitleBarKit</PackageId>
    <Version>0.1.0</Version>
    <Authors>chicuong2k3</Authors>
    <Description>An accessible, customizable Windows title bar built specifically for .NET MAUI Blazor Hybrid applications.</Description>
    <PackageTags>blazor hybrid maui windows titlebar webview</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/chicuong2k3/BlazorHybrid.TitleBarKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
