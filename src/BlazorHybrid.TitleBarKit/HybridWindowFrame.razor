<div class="bh-window-frame @Class" @attributes="AdditionalAttributes">
    <HybridTitleBar Title="@Title" Icon="@Icon" TitleContent="@TitleContent" Actions="@Actions" ShowWindowControls="@ShowWindowControls" WindowControls="@WindowControls" />
    <div class="bh-window-frame__content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Gets or sets the window title.</summary>
    [Parameter] public string Title { get; set; } = "Application";
    /// <summary>Gets or sets custom title content.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }
    /// <summary>Gets or sets optional icon content.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }
    /// <summary>Gets or sets optional title-bar actions.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>Gets or sets the application content.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    /// <summary>Gets or sets whether native window controls are rendered.</summary>
    [Parameter] public bool ShowWindowControls { get; set; } = true;
    /// <summary>Custom window controls when native controls are disabled in TitleBarOptions.</summary>
    [Parameter] public RenderFragment<TitleBarState>? WindowControls { get; set; }
    /// <summary>Gets or sets additional frame CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Gets or sets unmatched attributes applied to the frame.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
